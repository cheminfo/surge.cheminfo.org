  },
  "license": "MIT",
  "author": "Luc Patiny",
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "preview": "vite preview --host 0.0.0.0",
    "prettier": "prettier --check .",
