{
  "name": "surge-backend",
  "version": "0.0.0",
  "description": "Fastify API generating structural isomers with Surge",
  "type": "module",
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "node --env-file-if-exists=../.env --watch --experimental-strip-types src/server.ts",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "start": "node --env-file-if-exists=../.env --experimental-strip-types src/server.ts",
    "test": "npm run test-only && npm run check-types",
    "test-only": "vitest run --coverage",
    "test-watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.11.3",
    "mf-parser": "^3.9.2",
    "openchemlib": "^9.24.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@zakodium/tsconfig": "^1.0.5",
    "vitest": "^4.1.10"
  },
  "volta": {
    "extends": "../package.json"
  }
}
