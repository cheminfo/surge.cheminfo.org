# Copy this file to .env.
# Local dev: leave COMPOSE_FILE commented, then npm run dev.
# Docker:    uncomment one COMPOSE_FILE line, then docker compose up -d.

# Deployment mode: uncomment exactly ONE line to choose how the service is
# exposed. With none uncommented, docker compose uses compose.yaml by default.
# COMPOSE_FILE=compose.yaml             # port-published (publishes PORT on the host)
# COMPOSE_FILE=compose.traefik.yaml     # behind a Traefik reverse proxy
# COMPOSE_FILE=compose.cloudflared.yaml # behind a Cloudflare Tunnel (no published port)

# Port the service listens on. The Vite dev server takes PORT + 1.
PORT=31228

# Address the service binds to.
# HOST=0.0.0.0

# The reverse proxies whose X-Forwarded-For is believed: an address, a CIDR
# range, a comma separated list of either, or a hop count. Leave unset when
# nothing proxies this service. `true` believes any peer and is only safe when
# the port is unreachable except through the proxy. The Traefik and Cloudflare
# compose files default it to the Docker bridge range.
# TRUST_PROXY=192.168.1.5

# Path to the surge executable. Unset, the service looks for bin/surge
# (npm run install-surge) and then for surge on the PATH, which is where the
# Docker image compiles it.
# SURGE_PATH=/usr/local/bin/surge

# How many surge processes may run at the same time, and how many requests may
# wait for a free slot before the API answers 503.
# MAX_PARALLEL_GENERATIONS=4
# MAX_QUEUED_GENERATIONS=32

# Largest timeout, in seconds, and largest number of structures a caller may
# ask for.
# MAX_TIMEOUT_SECONDS=30
# MAX_LIMIT=100000

# Surge is killed once it has written this many bytes. Its output is copied a
# few times on the way to a response, so the peak heap is roughly six times
# this value: raise it only together with the container memory limit.
# MAX_OUTPUT_BYTES=33554432

# Cloudflare Tunnel token (compose.cloudflared.yaml only).
# TUNNEL_TOKEN=
