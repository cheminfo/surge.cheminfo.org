# Copy this file to .env.
# Local dev: leave COMPOSE_FILE commented, then npm run dev.
# Docker:    uncomment one COMPOSE_FILE line, then docker compose up -d.

# Deployment mode: uncomment exactly ONE line to choose how the service is
# exposed. With none uncommented, docker compose uses compose.yaml by default.
# COMPOSE_FILE=compose.yaml             # port-published (publishes PORT on the host)
# COMPOSE_FILE=compose.traefik.yaml     # behind a Traefik reverse proxy
# COMPOSE_FILE=compose.cloudflared.yaml # behind a Cloudflare Tunnel (no published port)

# Image the compose files run. IMAGE_TAG is rewritten by the server's deploy
# script on every deploy and rollback - do not edit it by hand.
IMAGE_NAME=ghcr.io/cheminfo/surge.cheminfo.org
IMAGE_TAG=latest

# Port the service listens on. The Vite dev server takes PORT + 1.
PORT=31228

# Where this deployment is mounted. Unset it answers at the root of its own
# host, which is what surge.cheminfo.org does. A deployment serving the tool
# under a path of a shared host names that path here — the container stamps it
# into every page when it starts, so the SAME image and the SAME tag serve both
# addresses and nothing is rebuilt:
#   BASE_PATH=/surge/   # for https://www.cheminfo.org/surge/
# BASE_PATH=/

# Analytics. The snippet the provider hands out, pasted whole and on one line:
# the container puts it at the end of the <head> of every page it serves, so a
# visitor is counted whichever address they arrived at. Unset — a dev run, or a
# deployment that measures nothing — nothing is loaded. The id below is a
# placeholder: take this site's own from https://datami.cheminfo.org — never
# copy another project's.
# TRACKING_SCRIPT=<script defer src="https://datami.cheminfo.org/script.js" data-website-id="00000000-0000-0000-0000-000000000000"></script>

# Cloudflare Tunnel token (compose.cloudflared.yaml only).
# TUNNEL_TOKEN=
